    "svelte": "^5.55.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@11.25.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
