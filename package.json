{
  "name": "@opensimgear/cockpit",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "ui:dev": "vite --host 127.0.0.1",
    "ui:build": "vite build",
    "web:dev": "vite --host 127.0.0.1",
    "web:native": "vite --mode native --host 127.0.0.1",
    "web:build": "vite build",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "transport:test": "node --test scripts/native-gateway-bridge.test.mjs src/lib/gateway.test.mjs src/lib/gateway-automation.test.mjs src/lib/gateway-workspace.test.mjs src/lib/controller-lifecycle.test.mjs src/lib/runtime-config.test.mjs src/lib/device-actions.test.mjs src/lib/dcs-bios.test.mjs src/lib/dcs-profile.test.mjs src/lib/debug-inputs.test.mjs src/lib/dcs-test-presets.test.mjs src/lib/integration-profile.test.mjs src/lib/games.test.mjs src/lib/controllers.test.mjs src/lib/mappings.test.mjs src/lib/scriptExamples.test.mjs",
    "mappings:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/mappings.test.mjs src/lib/scriptExamples.test.mjs",
    "controllers:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/controllers.test.mjs",
    "actions:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/device-actions.test.mjs",
    "dcs:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/dcs-bios.test.mjs",
    "dcs-profile:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/dcs-profile.test.mjs",
    "integration:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/integration-profile.test.mjs",
    "e2e": "python3 tests/e2e/run.py",
    "debug:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/debug-inputs.test.mjs src/lib/dcs-test-presets.test.mjs src/lib/dcs-profile.test.mjs",
    "games:coverage": "node --experimental-test-coverage --test-coverage-lines=71 --test-coverage-branches=71 --test-coverage-functions=71 --test src/lib/games.test.mjs src/lib/integration-profile.test.mjs src/lib/runtime-config.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
