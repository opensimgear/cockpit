{
  "name": "native-companion-serial",
  "projectType": "library",
  "root": "crates/companion-serial",
  "sourceRoot": "crates/companion-serial",
  "tags": [
    "native"
  ],
  "metadata": {
    "description": "Rust crate osg-companion-serial"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/src-tauri/Cargo.toml",
      "{workspaceRoot}/src-tauri/Cargo.lock",
      "{workspaceRoot}/Cargo.lock",
      "sharedGlobals",
      "{workspaceRoot}/.github/workflows/**/*",
      "{workspaceRoot}/tools/ci/**/*"
    ],
    "rustGlobals": [
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/src-tauri/Cargo.toml",
      "{workspaceRoot}/src-tauri/Cargo.lock",
      "{workspaceRoot}/Cargo.lock"
    ]
  },
  "targets": {
    "native": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "inputs": [
        "default",
        "^default",
        "rustGlobals"
      ],
      "options": {
        "command": "cargo test --manifest-path crates/companion-serial/Cargo.toml"
      }
    }
  },
  "implicitDependencies": [
    "native-companion-service"
  ]
}
