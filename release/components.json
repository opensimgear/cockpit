        "packages/companion-ui",
        "scripts/companion-mobile.py",
        "scripts/companion-mobile-build.py",
        "docs/companion-release-matrix.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "rust-toolchain.toml",
        ".cargo",
        ".npmrc",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        ".github/workflows"
      ],
      "versionFiles": [
        {
          "path": "apps/companion/package.json",
          "kind": "json"
        },
        {
          "path": "apps/companion/src-tauri/tauri.conf.json",
          "kind": "json"
        },
        {
          "path": "apps/companion/src-tauri/Cargo.toml",
          "kind": "cargo-package",
          "package": "osg-companion"
        },
        {
          "path": "apps/companion/src-tauri/Cargo.lock",
          "kind": "cargo-lock",
          "package": "osg-companion"
        }
      ]
    }
  }
