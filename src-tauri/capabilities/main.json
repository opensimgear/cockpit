{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local Cockpit window can manage gateway sessions and open its documentation.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-gateway-request",
    "allow-open-companion-browser",
    "allow-export-companion-certificate",
    "allow-optional-dependencies",
    "allow-optional-dependency-install",
    "allow-pick-game-executable",
    "allow-desktop-preferences",
    "allow-set-tray-preferences",
    "allow-set-autostart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.opensimgear.org"
        },
        {
          "url": "https://www.opensimgear.org/docs/architecture/desktop-cockpit/"
        },
        {
          "url": "https://github.com/opensimgear/device-gateway/tree/main/simulation/pico"
        }
      ]
    }
  ]
}
