{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local Cockpit window can manage gateway sessions and open its documentation.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-persistence-status",
    "allow-persistence-workspace",
    "allow-gateway-request",
    "allow-mcp-settings-get",
    "allow-mcp-settings-update",
    "allow-mcp-credential-create",
    "allow-mcp-credential-revoke",
    "allow-mcp-credential-rotate",
    "allow-profile-activation-window-open",
    "allow-profile-activation-window-update",
    "allow-profile-activation-window-state",
    "allow-profile-activation-window-close",
    "allow-profile-progress-settings-get",
    "allow-profile-progress-settings-save",
    "allow-open-companion-browser",
    "allow-export-companion-certificate",
    "allow-optional-dependencies",
    "allow-open-hidhide",
    "allow-open-vjoy",
    "allow-optional-dependency-install",
    "allow-pick-game-executable",
    "allow-pick-game-image",
    "allow-pick-game-integration-folder",
    "allow-desktop-preferences",
    "allow-set-tray-preferences",
    "allow-set-autostart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.opensimgear.org"
        },
        {
          "url": "https://www.opensimgear.org/docs/architecture/desktop-cockpit/"
        },
        {
          "url": "https://github.com/opensimgear/device-gateway/tree/main/simulation/pico"
        }
      ]
    },
    "allow-persistence-ui-read",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
